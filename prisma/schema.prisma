generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 Int               @id @default(autoincrement())
  name               String
  image              String
  additionalImages   String[]
  categoryId         Int
  price              Float
  shortDescription   String
  fullDescription    String
  details            String[]
  isVisible          Boolean           @default(true)
  hasLetterSelection Boolean?          @default(false)
  category           Category          @relation(fields: [categoryId], references: [id])
  wholesaleOptions   WholesaleOption[] @relation("WholesaleOptions")
}

model WholesaleOption {
  id          Int     @id @default(autoincrement())
  minQuantity Int
  unitPrice   Float
  productId   Int
  product     Product @relation("WholesaleOptions", fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  image     String?
  isVisible Boolean   @default(true)
  products  Product[]
}

model Order {
  id                String   @id @default(cuid())
  paymentId         String?  @unique
  preferenceId      String?
  externalReference String?
  status            String
  items             Json
  total             Float
  customerEmail     String?
  customerName      String?
  customerPhone     String?
  paymentMethod     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
